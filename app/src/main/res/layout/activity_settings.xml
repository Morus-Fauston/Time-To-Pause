<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="软件设置"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- ============================================================ -->
        <!-- 显示 -->
        <!-- ============================================================ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/cbFloatBallVideoOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="悬浮球仅看视频时显示"
            android:textSize="15sp"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbPauseShowFloatBall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂停期间显示悬浮球"
            android:textSize="15sp"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbShowNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="在通知栏显示"
            android:textSize="15sp"
            android:layout_marginBottom="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <!-- ============================================================ -->
        <!-- 宽限 -->
        <!-- ============================================================ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="宽限"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="时长（秒）："
                android:textSize="15sp"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/etGraceDuration"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:inputType="number"
                android:gravity="center"
                android:textSize="15sp"
                android:background="@drawable/bg_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <!-- ============================================================ -->
        <!-- 时段与费率 -->
        <!-- ============================================================ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="时段与费率"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- RangeSlider: 白天时段 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="白天时段"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/sliderDayPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:valueFrom="0"
            android:valueTo="24" />

        <TextView
            android:id="@+id/tvDayPeriodLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="白天 6:00 — 23:00"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <!-- 费率输入框 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="白天消耗"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etConsumeDay"
                    android:layout_width="90dp"
                    android:layout_height="44dp"
                    android:inputType="number"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:background="@drawable/bg_input"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="白天恢复"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etRecoverDay"
                    android:layout_width="90dp"
                    android:layout_height="44dp"
                    android:inputType="number"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:background="@drawable/bg_input"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="夜间消耗"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etConsumeNight"
                    android:layout_width="90dp"
                    android:layout_height="44dp"
                    android:inputType="number"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:background="@drawable/bg_input"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="夜间恢复"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etRecoverNight"
                    android:layout_width="90dp"
                    android:layout_height="44dp"
                    android:inputType="number"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:background="@drawable/bg_input"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <!-- 其他操作 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnResetGuide"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="重新引导权限"
            android:textSize="14sp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnShutdown"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="关闭应用"
            android:textSize="14sp"
            android:textColor="#F87171"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- 按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnResetDefaults"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="恢复默认"
                android:textSize="14sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginRight="12dp" />

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="确定"
                android:textSize="14sp"
                android:layout_marginLeft="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
